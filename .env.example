# Copy this into Render's Environment (Dashboard → your service → Environment),
# or into a local .env for development. Never commit real secrets.
#
# --- Oanda (scalp live feed) ---
# PRACTICE-account key. OANDA_ENV must be 'practice' for this key (live endpoint
# rejects it). If you get a live account later, set OANDA_ENV=live and use the
# live key here.
OANDA_TOKEN=your-oanda-api-token
OANDA_ENV=practice
#
# --- Scalp DB location ---
# Point BOTH the sidecar and the bot at the same file. On Render, mount a Disk
# at /data and use SCALP_DB_PATH=/data/scalps.sqlite so history survives deploys.
SCALP_DB_PATH=/data/scalps.sqlite
#
# --- Existing bot env (already set on Render) ---
# TWELVEDATA_API_KEY, TELEGRAM_TOKEN, TELEGRAM_CHAT_ID, ADMIN_PASSWORD,
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN
